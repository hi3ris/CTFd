# =============================================================================
# NCTF26 — fenêtres de compétition (epoch secondes, GMT = heure de Lomé)
# =============================================================================
# Le seed (deploy/local/seed.py -> set_configs) lit CTF_START / CTF_END /
# CTF_FREEZE et les applique via l'API config de CTFd. C'est IDEMPOTENT :
# relancer `make local-seed` avec ces variables met à jour une instance DÉJÀ
# installée — c'est comme ça qu'on bascule présélection -> finale sans reset.
#
# Usage :
#   export $(grep -v '^#' deploy/event-windows.env.example | xargs)   # ou copier le bloc voulu
#   cd deploy && make local-seed
# ou en une ligne :
#   CTF_START=... CTF_END=... CTF_FREEZE=... make local-seed
#
# Variables :
#   CTF_START   ouverture   (avant : compte à rebours, épreuves verrouillées)
#   CTF_END     clôture      (après : soumissions fermées)
#   CTF_FREEZE  gel public   (après : le scoreboard PUBLIC est figé à cet instant ;
#                             les scores continuent de compter, l'admin voit en direct)
#   (laisser une variable vide/absente => réglage inchangé)
# -----------------------------------------------------------------------------

# --- PRÉSÉLECTION : ven 23 oct 00:00 -> dim 25 oct 23:59 (72 h non-stop) ------
# freeze la dernière heure (dim 25 oct 23:00) pour un final à suspense.
CTF_START=1792713600    # 2026-10-23 00:00:00 GMT
CTF_END=1792972740      # 2026-10-25 23:59:00 GMT
CTF_FREEZE=1792969200   # 2026-10-25 23:00:00 GMT

# --- FINALE : 24 h, DÉBUT À FIXER LE JOUR J (jamais après midi) ---------------
# L'heure de début dépend de la cérémonie d'ouverture et des discours. Le jour J,
# donne juste l'heure de début à ./finale-window.sh : il calcule fin (+24 h) et
# freeze (dernière heure) et peut appliquer directement.
#
#   deploy/finale-window.sh '2026-10-29 10:30'            # affiche les epochs
#   deploy/finale-window.sh '2026-10-29 10:30' --apply    # + applique (local)
#   deploy/finale-window.sh '2026-10-29 10:30' --apply --url https://ctf.exemple.tg
#
# Exemple pour un début à 10:30 (À REMPLACER par l'heure réelle) :
# CTF_START=1793269800    # 2026-10-29 10:30 GMT
# CTF_END=1793356200      # 2026-10-30 10:30 GMT  (+24 h)
# CTF_FREEZE=1793352600   # 2026-10-30 09:30 GMT  (dernière heure)
