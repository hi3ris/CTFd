# =============================================================================
# NCTF26 — fenêtres de compétition (epoch secondes, GMT = heure de Lomé)
# =============================================================================
# Le seed (deploy/local/seed.py -> set_configs) lit CTF_START / CTF_END /
# CTF_FREEZE et les applique via l'API config de CTFd. C'est IDEMPOTENT :
# relancer `make local-seed` avec ces variables met à jour une instance DÉJÀ
# installée — c'est comme ça qu'on bascule présélection -> finale sans reset.
#
# Usage :
#   export $(grep -v '^#' deploy/event-windows.env.example | xargs)   # ou copier le bloc voulu
#   cd deploy && make local-seed
# ou en une ligne :
#   CTF_START=... CTF_END=... CTF_FREEZE=... make local-seed
#
# Variables :
#   CTF_START   ouverture   (avant : compte à rebours, épreuves verrouillées)
#   CTF_END     clôture      (après : soumissions fermées)
#   CTF_FREEZE  gel public   (après : le scoreboard PUBLIC est figé à cet instant ;
#                             les scores continuent de compter, l'admin voit en direct)
#   (laisser une variable vide/absente => réglage inchangé)
# -----------------------------------------------------------------------------

# --- PRÉSÉLECTION : ven 23 oct 19:00 -> lun 26 oct 00:00 (53 h non-stop) ------
# Fenêtre décidée : départ vendredi 19h, clôture nuit dimanche->lundi à minuit.
# freeze la dernière heure (dim 25 oct 23:00) pour un final à suspense.
CTF_START=1792782000    # 2026-10-23 19:00:00 GMT (ven, ouverture)
CTF_END=1792972800      # 2026-10-26 00:00:00 GMT (lun 00h, clôture)
CTF_FREEZE=1792969200   # 2026-10-25 23:00:00 GMT (dim 23h, gel public)

# --- FINALE : 24 h, DÉBUT À FIXER LE JOUR J (jamais après midi) ---------------
# L'heure de début dépend de la cérémonie d'ouverture et des discours. Le jour J,
# donne juste l'heure de début à ./finale-window.sh : il calcule fin (+24 h) et
# freeze (dernière heure) et peut appliquer directement.
#
#   deploy/finale-window.sh '2026-10-29 10:30'            # affiche les epochs
#   deploy/finale-window.sh '2026-10-29 10:30' --apply    # + applique (local)
#   deploy/finale-window.sh '2026-10-29 10:30' --apply --url https://ctf.exemple.tg
#
# Exemple pour un début à 10:30 (À REMPLACER par l'heure réelle) :
# CTF_START=1793269800    # 2026-10-29 10:30 GMT
# CTF_END=1793356200      # 2026-10-30 10:30 GMT  (+24 h)
# CTF_FREEZE=1793352600   # 2026-10-30 09:30 GMT  (dernière heure)

# =============================================================================
# First bloods (plugin firstblood, actif par défaut) — "🩸 First blood — <équipe>
# ouvre <épreuve>" en notification publique, segment du ruban HUD et ticker du
# Grand Prix en mode projecteur (/scoreboard?big=1). Rien après le gel.
# -----------------------------------------------------------------------------
# FIRSTBLOOD_ENABLED=1          # 0 pour couper l'annonceur (le fil /api/recent reste)
# FIRSTBLOOD_TICK=5             # secondes entre deux passes
# FIRSTBLOOD_BONUS=0            # points bonus par first blood (award "firstblood") ;
#                               # 0 = aucun. À trancher avec le règlement AVANT l'ouverture.

# =============================================================================
# King of the Hill (optionnel) — activé quand KOTH_SCORER_SECRET + KOTH_HILLS
# sont posés sur CTFd (voir deploy/koth-ops.md). Le plafond de points d'une
# équipe qui tiendrait une colline tout du long = points × (durée / tick).
# -----------------------------------------------------------------------------
# --- PRÉSÉLECTION : 72 h non-stop → bonus d'assiduité, pas la moitié du tableau
# KOTH_TICK=60                 # une passe de scoring par minute
# KOTH_HILLS='[{"id":"koth-throne","name":"The Throne","url":"http://koth-throne:8080","player_url":"https://ctf.exemple.tg/koth-throne","points":1}]'
#                              # plafond 1 colline : 1 × (259200/60) ≈ 4 320 pts
#
# --- FINALE : 24 h → format spectacle, on peut monter et/ou ajouter une colline
# KOTH_TICK=30
# KOTH_HILLS='[{"id":"koth-throne","name":"The Throne","url":"http://koth-throne:8080","player_url":"https://ctf.exemple.tg/koth-throne","points":5},{"id":"koth-citadel","name":"The Citadel","url":"http://koth-citadel:8081","player_url":"ssh://player@ctf.exemple.tg:2222","points":5,"scorer_secret":"<secret-dédié-citadel>"}]'
# Finale « spectacle » avec les trois collines boot2root en plus (root=pleins,
# user=moitié ; construire la base d'abord, cf. deploy/koth-ops.md) :
# KOTH_HILLS='[{"id":"koth-throne","name":"The Throne","url":"http://koth-throne:8080","player_url":"https://ctf.exemple.tg/koth-throne","points":5},{"id":"koth-armory","name":"The Armory","url":"http://koth-armory:8082","player_url":"ssh://player@ctf.exemple.tg:2202","points":5},{"id":"koth-foundry","name":"The Foundry","url":"http://koth-foundry:8082","player_url":"ssh://player@ctf.exemple.tg:2203","points":5},{"id":"koth-vault","name":"The Vault","url":"http://koth-vault:8082","player_url":"ssh://player@ctf.exemple.tg:2204","points":5}]'
#                              # plafond 1 colline : 5 × (86400/30) = 14 400 pts
