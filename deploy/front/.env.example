# Copier en .env sur le front, puis remplacer chaque valeur.
# Generer un secret : openssl rand -hex 32

SECRET_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Nombre de workers gunicorn. 2 suffit hors evenement sur t4g.small ;
# monter a 4 le jour J si vous passez sur une instance plus grosse.
WORKERS=2

# Renseignes automatiquement par `make event-up`, vides le reste de l'annee.
OLLAMA_URL=
DOCKER_HOST=

# Domaine et email utilises pour Let's Encrypt.
CTF_DOMAIN=ctf.exemple.com
CERTBOT_EMAIL=admin@exemple.com
