# Copier en .env sur le front, puis remplacer chaque valeur.
# Generer un secret : openssl rand -hex 32

SECRET_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Nombre de workers gunicorn.
#   2  phase setup / final  (t4g.small, ~50 joueurs)
#   4  phase preselection   (t4g.medium, ~300 joueurs)
WORKERS=2

# Renseignes automatiquement par `make link`, vides hors phase active.
OLLAMA_URL=
DOCKER_HOST=

# Domaine et email utilises pour Let's Encrypt.
CTF_DOMAIN=ctf.exemple.com
CERTBOT_EMAIL=admin@exemple.com
