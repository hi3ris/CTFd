# Copier en .env sur le front, puis remplacer chaque valeur.
# Generer un secret : openssl rand -hex 32

# --- Obligatoire, a renseigner a la main -------------------------------------

SECRET_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Secret global des flags par equipe. Le meme secret doit etre utilise par
# l'instancier quand il calcule TEAM_SECRET = HMAC(CTF_TEAM_FLAG_SECRET, team_id)
# pour chaque conteneur. La classe de flag team_hmac le lit pour valider les
# soumissions. openssl rand -hex 32
CTF_TEAM_FLAG_SECRET=

# Domaine du CTF et adresse utilisee pour Let's Encrypt. `make tls-init` les
# lit ; sans eux, pas de certificat, donc pas de HTTPS.
CTF_DOMAIN=ctf.exemple.com
CERTBOT_EMAIL=admin@exemple.com

# --- Ecrits automatiquement par `make link` selon la phase --------------------
# Ne les modifiez pas a la main : le prochain `make link` les ecrasera.

# Workers gunicorn. 2 en setup et en finale, 4 en preselection.
WORKERS=2

# Buffer pool MariaDB. 256M en setup et en finale, 1G en preselection.
INNODB_POOL=256M

# IP privee de l'arena, consommee par le tunnel dockerproxy.
ARENA_HOST=

# Endpoint Docker de l'arena, vu par CTFd a travers dockerproxy.
DOCKER_HOST=

# Endpoint Ollama sur le noeud IA. Vide = challenges IA indisponibles.
OLLAMA_URL=
