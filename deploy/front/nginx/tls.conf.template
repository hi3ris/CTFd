# Configuration de PRODUCTION. Ce fichier est un modele : `make tls-init`
# remplace __CTF_DOMAIN__ par le domaine reel et l'installe comme
# configuration active.

upstream ctfd {
    server ctfd:8000;
}

proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=ctfd_static:10m
                 max_size=256m inactive=60m use_temp_path=off;

# Toute requete dont le Host ne correspond pas au domaine du CTF est fermee
# sans reponse. Sans ce bloc, un serveur par defaut accepterait n'importe quel
# Host et rouvrirait la porte que proxy-headers.inc vient de fermer.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/__CTF_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CTF_DOMAIN__/privkey.pem;

    return 444;
}

server {
    listen 80;
    server_name __CTF_DOMAIN__;

    # Le renouvellement doit rester joignable en clair.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __CTF_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__CTF_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CTF_DOMAIN__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;

    client_max_body_size 100M;

    location / {
        proxy_pass http://ctfd;
        include /etc/nginx/conf.d/proxy-headers.inc;
    }

    location /themes/ {
        proxy_pass        http://ctfd;
        proxy_cache       ctfd_static;
        proxy_cache_valid 200 60m;
        include /etc/nginx/conf.d/proxy-headers.inc;
        # nginx n'herite PAS les add_header du bloc server des qu'un add_header
        # existe ici : on redeclare les en-tetes de securite, sinon les JS/CSS de
        # theme partiraient sans nosniff/HSTS/X-Frame-Options.
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "SAMEORIGIN" always;
        add_header X-Cache-Status $upstream_cache_status;
    }
}
