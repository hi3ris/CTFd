# Copier en terraform.tfvars et adapter.

aws_region   = "eu-west-3" # Paris
project_name = "ctf"

# Contenu de votre cle publique SSH.
ssh_public_key = "ssh-ed25519 AAAA... vous@machine"

# IP publique de votre bureau / VPN. NE PAS mettre 0.0.0.0/0 ici.
admin_cidrs = ["203.0.113.42/32"]

# Qui peut atteindre le CTF. Ouvert a tous pendant l'evenement.
player_cidrs = ["0.0.0.0/0"]

# Domaine du CTF (optionnel ; sans lui on utilise l'IP publique).
domain_name = "ctf.exemple.com"

# --- Cout --------------------------------------------------------------------
# Laisser false toute l'annee. `make event-up` le bascule a true.
arena_enabled = false

front_instance_type = "t4g.small"   # ~12 USD/mois
arena_instance_type = "c6a.2xlarge" # ~0.31 USD/h, uniquement pendant l'evenement
arena_use_spot      = false         # true pour les repetitions, false le jour J
