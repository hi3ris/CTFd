#!/usr/bin/env bash
# Provisionnement de l'arena : Docker Swarm des challenges + Ollama.
# Rejoue a chaque `make event-up` puisque l'instance est recreee.
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --no-install-recommends ca-certificates curl git jq

# --- Docker ------------------------------------------------------------------
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
  -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get update
apt-get install -y \
  docker-ce docker-ce-cli containerd.io \
  docker-buildx-plugin docker-compose-plugin

usermod -aG docker ubuntu
systemctl enable --now docker

# --- Swarm -------------------------------------------------------------------
# Mono-noeud : suffisant pour isoler les instances par equipe dans des reseaux
# overlay distincts, sans la complexite d'un cluster multi-noeuds.
if ! docker info --format '{{.Swarm.LocalNodeState}}' | grep -q active; then
  docker swarm init --advertise-addr "$(hostname -I | awk '{print $1}')"
fi

# Reseau overlay partage par les services frpc <-> instances de challenge.
docker network create \
  --driver overlay \
  --attachable \
  --subnet 172.30.0.0/16 \
  ctfd_challenges 2>/dev/null || true

# --- frpc : publie les instances de challenge via le front -------------------
FRP_VERSION=0.61.1
ARCH=$(dpkg --print-architecture) # amd64 sur l'arena

curl -fsSL -o /tmp/frp.tar.gz \
  "https://github.com/fatedier/frp/releases/download/v$${FRP_VERSION}/frp_$${FRP_VERSION}_linux_$${ARCH}.tar.gz"
tar -xzf /tmp/frp.tar.gz -C /tmp
install -m 0755 "/tmp/frp_$${FRP_VERSION}_linux_$${ARCH}/frpc" /usr/local/bin/frpc
rm -rf /tmp/frp.tar.gz "/tmp/frp_$${FRP_VERSION}_linux_$${ARCH}"

mkdir -p /etc/frp

# Le fichier de conf est complete par `make event-up`, qui y injecte le jeton
# lu sur le front. frpc redemarre tout seul une fois le jeton en place.
cat > /etc/frp/frpc.toml <<EOF
serverAddr = "${front_private_ip}"
serverPort = ${frp_bind_port}
auth.method = "token"
auth.token = "REMPLACE_TOKEN"

# ctfd-whale reecrit ce fichier via l'API admin de frpc pour chaque instance
# d'equipe creee ou detruite. Cette API est pilotee depuis le front par le
# canal Docker, jamais depuis le reseau des challenges : elle reste donc sur la
# boucle locale. Exposee sur 0.0.0.0, tout conteneur de challenge - donc tout
# joueur ayant obtenu du code, ce qui est le but d'un challenge pwn - pourrait
# reecrire les tunnels de toutes les equipes.
webServer.addr = "127.0.0.1"
webServer.port = 7400
webServer.user = "admin"
webServer.password = "REMPLACE_ADMIN_PASSWORD"

log.to = "/var/log/frpc.log"
log.level = "info"
EOF

# Le fichier contient le jeton frp et le mot de passe d'administration.
chmod 600 /etc/frp/frpc.toml

cat > /etc/systemd/system/frpc.service <<'EOF'
[Unit]
Description=frp client
After=network.target docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/frpc -c /etc/frp/frpc.toml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable frpc
# Pas de `start` ici : le jeton n'est pas encore injecte.

# --- Images des challenges ---------------------------------------------------
# L'arena est detruite et recreee a chaque changement de phase : son disque ne
# conserve rien. Sans cette etape, l'arena demarre le 23 octobre sans une seule
# image de challenge et l'instancier ne peut rien lancer.
#
# Les images sont archivees en tarballs dans le bucket S3 qui, lui, survit aux
# editions. Elles y sont poussees par `make push-images` depuis la machine de
# l'auteur des challenges.

apt-get install -y --no-install-recommends awscli

mkdir -p /opt/challenge-images

if aws s3 ls "s3://${archive_bucket}/images/" >/dev/null 2>&1; then
  aws s3 sync "s3://${archive_bucket}/images/" /opt/challenge-images/ --only-show-errors

  loaded=0
  for tarball in /opt/challenge-images/*.tar; do
    [ -e "$tarball" ] || continue
    if docker load -i "$tarball"; then
      loaded=$((loaded + 1))
    else
      echo "ECHEC du chargement de $tarball" >&2
    fi
  done
  echo "$loaded image(s) de challenge chargee(s)" > /var/log/challenge-images.log
else
  echo "AUCUNE image trouvee dans s3://${archive_bucket}/images/" > /var/log/challenge-images.log
fi

# Plage de ports reservee aux instances de challenge, pour memoire.
echo "WHALE_PORT_RANGE=${port_range_start}-${port_range_end}" > /etc/ctf-arena.env

# Le marqueur ne dit pas "les images attendues sont la" - `make check-arena`
# s'en charge, parce que la liste attendue vit avec les challenges, pas ici.
touch /var/lib/cloud/ctfd-arena-provisioned
