{
  "version": 4,
  "terraform_version": "1.7.5",
  "serial": 3,
  "lineage": "d3adb33f-0000-4000-8000-000000000000",
  "outputs": {},
  "resources": [
    {
      "mode": "managed",
      "type": "random_password",
      "name": "vault",
      "provider": "provider[\"registry.terraform.io/hashicorp/random\"]",
      "instances": [
        {
          "schema_version": 3,
          "attributes": {
            "id": "none",
            "length": 22,
            "special": false,
            "result": "tf-dev-vault-pass-2024"
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "result"
              }
            ]
          ]
        }
      ]
    },
    {
      "mode": "data",
      "type": "external",
      "name": "encrypt",
      "provider": "provider[\"registry.terraform.io/hashicorp/external\"]",
      "instances": [
        {
          "attributes": {
            "id": "-",
            "program": [
              "python3",
              "./encrypt.py"
            ],
            "query": {
              "passphrase": "tf-dev-vault-pass-2024",
              "infile": "secret.txt"
            },
            "result": {
              "path": "vault.enc"
            }
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "local_file",
      "name": "vault_marker",
      "provider": "provider[\"registry.terraform.io/hashicorp/local\"]",
      "instances": [
        {
          "attributes": {
            "filename": "./.vault-written",
            "content": "vault.enc",
            "id": "aa11bb22cc33"
          }
        }
      ]
    }
  ]
}
